[
  {
    "start": 7,
    "end": 8.670451506176793,
    "text": "(喵) 人類聽好"
  },
  {
    "start": 8.730451506176793,
    "end": 9.834882254062276,
    "text": "低頭跪好"
  },
  {
    "start": 9.894882254062276,
    "end": 10.999313001947758,
    "text": "眼睛看好"
  },
  {
    "start": 11.059313001947759,
    "end": 12.163743749833241,
    "text": "本喵出場"
  },
  {
    "start": 12.223743749833242,
    "end": 14.497571760185707,
    "text": "這不是普通的毛"
  },
  {
    "start": 14.557571760185708,
    "end": 16.831399770538173,
    "text": "這是本喵親自掉"
  },
  {
    "start": 16.89139977053817,
    "end": 19.490060353798132,
    "text": "一邊躺平打個哈欠"
  },
  {
    "start": 19.55006035379813,
    "end": 22.79838608287308,
    "text": "一邊順手送你一撮光耀"
  },
  {
    "start": 22.85838608287308,
    "end": 25.180938979161667,
    "text": "翻個身 就灑一地"
  },
  {
    "start": 25.240938979161665,
    "end": 27.563491875450254,
    "text": "走兩步 又多幾縷"
  },
  {
    "start": 27.623491875450252,
    "end": 30.8718176045252,
    "text": "什麼都沒做都這麼尊貴"
  },
  {
    "start": 30.9318176045252,
    "end": 33.85531076069265,
    "text": "你還在那邊算來算去"
  },
  {
    "start": 33.915310760692655,
    "end": 37.34310648629899,
    "text": "喵布布本喵掉的毛 (嘿)"
  },
  {
    "start": 37.403106486298995,
    "end": 42.53627321966968,
    "text": "尊貴到你不敢吸一口 (不敢吸一口)"
  },
  {
    "start": 42.59627321966968,
    "end": 46.00701523519838,
    "text": "每天躺著懶腰就長成寶"
  },
  {
    "start": 46.06701523519838,
    "end": 48.84676997785427,
    "text": "想不想要 你自己說"
  },
  {
    "start": 48.906769977854275,
    "end": 52.33456570346061,
    "text": "喵布布本喵掉的毛 (喵)"
  },
  {
    "start": 52.394565703460614,
    "end": 56.14638192054218,
    "text": "一根一根都帶傲嬌氣味飄"
  },
  {
    "start": 56.206381920542185,
    "end": 58.6450624616452,
    "text": "錢放下 人可以走"
  },
  {
    "start": 58.705062461645205,
    "end": 62.797952880279645,
    "text": "能不能買到看我心情好不好"
  },
  {
    "start": 62.85795288027965,
    "end": 65.50533834947574,
    "text": "貼心標籤 本喵原廠"
  },
  {
    "start": 65.56533834947574,
    "end": 68.86238896448681,
    "text": "無人敢仿 假貨滾遠一丈"
  },
  {
    "start": 68.92238896448681,
    "end": 72.13823143627101,
    "text": "每一根都含「懶得理你」"
  },
  {
    "start": 72.19823143627102,
    "end": 77.5417272605993,
    "text": "過敏？那是你信仰不夠虔誠一點點而已"
  },
  {
    "start": 77.6017272605993,
    "end": 79.85931364230639,
    "text": "你在那喊價 888"
  },
  {
    "start": 79.91931364230639,
    "end": 82.84280679847384,
    "text": "吵到本喵耳朵都要折"
  },
  {
    "start": 82.90280679847385,
    "end": 85.61515878225143,
    "text": "本喵一甩尾巴說 88"
  },
  {
    "start": 85.67515878225143,
    "end": 88.9722093972625,
    "text": "給你機會示好 不算太苛"
  },
  {
    "start": 89.0322093972625,
    "end": 92.80107932442172,
    "text": "喵布布本喵掉的毛 (喵喵)"
  },
  {
    "start": 92.86107932442172,
    "end": 97.99424605779241,
    "text": "尊貴到你不敢吸一口 (深呼吸都抖)"
  },
  {
    "start": 98.05424605779241,
    "end": 101.46498807332111,
    "text": "每天躺著懶腰就長成寶"
  },
  {
    "start": 101.52498807332111,
    "end": 104.304742815977,
    "text": "想不想要 你自己說"
  },
  {
    "start": 104.364742815977,
    "end": 107.79253854158334,
    "text": "喵布布本喵掉的毛 (嘿)"
  },
  {
    "start": 107.85253854158334,
    "end": 111.60435475866491,
    "text": "一根一根都帶傲嬌氣味飄"
  },
  {
    "start": 111.66435475866491,
    "end": 114.10303529976792,
    "text": "錢放下 人可以走"
  },
  {
    "start": 114.16303529976793,
    "end": 118.25592571840237,
    "text": "能不能買到看我心情好不好"
  },
  {
    "start": 118.31592571840237,
    "end": 121.22804973451807,
    "text": "今天想掉 就掉一床"
  },
  {
    "start": 121.28804973451807,
    "end": 125.27212124122849,
    "text": "明天不爽 全部收回去珍藏"
  },
  {
    "start": 125.33212124122849,
    "end": 130.38814023853365,
    "text": "後天開心 可能當著你面吞回肚裡"
  },
  {
    "start": 130.44814023853365,
    "end": 136.18305931321547,
    "text": "你只剩滑手機看本喵的相片而已 (喵)"
  },
  {
    "start": 136.24305931321547,
    "end": 138.84171989647544,
    "text": "喵布布本喵掉的毛"
  },
  {
    "start": 138.90171989647544,
    "end": 142.47487819845787,
    "text": "你買到是本喵賞臉的號召"
  },
  {
    "start": 142.53487819845787,
    "end": 146.80642653219144,
    "text": "這不是交易 是你向上朝聖一秒"
  },
  {
    "start": 146.86642653219144,
    "end": 148.86414685557253,
    "text": "頭低一點 別吵"
  },
  {
    "start": 148.92414685557253,
    "end": 152.3348888711012,
    "text": "喵布布本喵掉的毛 (喵~)"
  },
  {
    "start": 152.39488887110122,
    "end": 155.96804717308365,
    "text": "最後通牒就說到這麼高傲"
  },
  {
    "start": 156.02804717308365,
    "end": 158.35060006937223,
    "text": "錢放下 人可以走"
  },
  {
    "start": 158.41060006937224,
    "end": 162,
    "text": "排隊朝拜本喵就好 (喵喵)"
  }
]