<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VideoMerge.Avalonia.App"
             xmlns:local="using:VideoMerge.Avalonia"
             RequestedThemeVariant="Dark">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Resources>
    <Color x:Key="VmBg">#1F1F1F</Color>
    <Color x:Key="VmSurface">#2A2A2A</Color>
    <Color x:Key="VmSurface2">#333333</Color>
    <Color x:Key="VmInk">#F4F1EE</Color>
    <Color x:Key="VmMuted">#B5A8A2</Color>
    <Color x:Key="VmFaint">#7A706C</Color>
    <Color x:Key="VmPrimary">#C94A32</Color>
    <Color x:Key="VmBorder">#3D3D3D</Color>
    <SolidColorBrush x:Key="VmBgBrush" Color="{StaticResource VmBg}" />
    <SolidColorBrush x:Key="VmSurfaceBrush" Color="{StaticResource VmSurface}" />
    <SolidColorBrush x:Key="VmSurface2Brush" Color="{StaticResource VmSurface2}" />
    <SolidColorBrush x:Key="VmInkBrush" Color="{StaticResource VmInk}" />
    <SolidColorBrush x:Key="VmMutedBrush" Color="{StaticResource VmMuted}" />
    <SolidColorBrush x:Key="VmPrimaryBrush" Color="{StaticResource VmPrimary}" />
    <SolidColorBrush x:Key="VmBorderBrush" Color="{StaticResource VmBorder}" />
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource VmBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource VmInkBrush}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft JhengHei UI, sans-serif" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{StaticResource VmMutedBrush}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="IBM Plex Mono, Cascadia Mono, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource VmMutedBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource VmPrimaryBrush}" />
      <Setter Property="Foreground" Value="{StaticResource VmInkBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource VmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource VmMutedBrush}" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#6B3030" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#E8A0A0" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource VmSurface2Brush}" />
      <Setter Property="BorderBrush" Value="{StaticResource VmBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource VmInkBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Background" Value="{StaticResource VmSurface2Brush}" />
      <Setter Property="BorderBrush" Value="{StaticResource VmBorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource VmInkBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="MinWidth" Value="72" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{StaticResource VmSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource VmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style Selector="Border.clip">
      <Setter Property="Background" Value="{StaticResource VmSurface2Brush}" />
      <Setter Property="BorderBrush" Value="{StaticResource VmBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="{StaticResource VmPrimaryBrush}" />
      <Setter Property="Background" Value="#1A1A1A" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="99" />
    </Style>
  </Application.Styles>
</Application>
